# WattNot environment variables: NAMES ONLY. Never put a real value in this file or commit one.
# Copy to .env (gitignored), fill in only what you need, then: set -a; . ./.env; set +a
# Nothing here is needed for the tests or the keyless replay:
#   PYTHONPATH=src WATTNOT_META_MOCK=1 python -m wattnot.dash --replay-only --events replays/modal-r2/events.jsonl --port 8795

## Secrets (keep out of git)
META_API_KEY=                 # Meta Model API (Muse Spark, Wonder, Voice Transcribe); or `muse login`
BASETEN_METRICS_KEY=          # Baseten workspace key (the only Baseten key the code uses)
BASETEN_API_KEY=              # legacy hackathon key; dead (401), refused by the code; leave empty
HF_TOKEN=                     # Hugging Face, for gated open-weights downloads on a GPU host
E2E_API_KEY=                  # E2E Networks VM API (scripts/e2e/ctl.py via post.py)
E2E_API_TOKEN=                # E2E Networks VM API token
MODAL_TOKEN_ID=               # read by the modal CLI itself (usually ~/.modal.toml instead)
MODAL_TOKEN_SECRET=
MODAL_PROXY_TOKEN_ID=         # Modal web-endpoint proxy auth
MODAL_PROXY_TOKEN_SECRET=
WATTNOT_API_TOKEN=            # optional bearer token for the WattNot API
WATTNOT_DASH_TOKEN=           # optional bearer token for a hosted dashboard
WATCHDOG_PUBLISH_TOKEN=       # optional, watchdog heartbeat publishing

## Keys on disk (paths, not secrets themselves)
WATTNOT_CERT_KEY=             # certificate signing key path (default ~/.wattnot/cert-signing-key.pem)
WATTNOT_SIGN_KEY=             # receipt signing key path override
WATTNOT_REQUIRE_CERT_KEY=     # 1 = fail instead of falling back when the cert key is missing
WATTNOT_MUSE_AUTH=            # Muse login file path (default ~/.config/muse/auth.json)

## Endpoints and models
META_BASE_URL=
WATTNOT_META_BASE=
MODAL_ENDPOINT_URL=
WATTNOT_MODAL_URL=
WATTNOT_BASE_URL=             # OpenAI-compatible server WattNot tunes (e.g. local vLLM)
JUDGE_BASE_URL=
JUDGE_MODEL=
WATTNOT_PLANNER_MODEL=
WATTNOT_SPARK_MODEL=
WATTNOT_SERVE_MODEL=
WATTNOT_SERVE_TP=
WATTNOT_SERVE_TOPK=

## Safety switches and spend caps (env can only tighten the built-in caps)
WATTNOT_META_MOCK=            # 1 = mock every Meta call, labelled MOCK
WATTNOT_LIVE=
WATTNOT_MODE=                 # watch | act
WATTNOT_MODAL_GO=             # 1 = allow a paid Modal launch (needs the owner's okay)
WATTNOT_MODAL_SMOKE=
RUN3_GO=                      # 1 = allow an E2E VM launch (needs the owner's okay)
RUN3_MAX_H=
RUN3_BUDGET_CAP_INR=
RUN3_DISK_GB=
BUDGET_CAP_INR=
MAX_HOURS=
WATTNOT_META_CAP_USD=
WATTNOT_META_SOFT_USD=
WATTNOT_BASETEN_CAP_USD=
WATTNOT_MAX_P99_INCREASE=
WATTNOT_APPROVAL_POLICY=
WATTNOT_APPROVER=
WATTNOT_ALLOW_NVML=

## Paths and tuning (optional)
WATTNOT_CONFIG=
WATTNOT_DATA_DIR=
WATTNOT_ROOT=
WATTNOT_SPEND_DIR=
WATTNOT_META_LEDGER=
WATTNOT_BASETEN_H2H_LEDGER=
WATTNOT_PROPOSALS_DIR=
WATTNOT_PREFIX_CACHE=         # on | off | auto
WATTNOT_PREFIX_CACHE_THRESHOLD=
WATTNOT_REASONING_MAX_TOKENS=
WATTNOT_REASONING_CAPS=
WATTNOT_STEPUP_MAX_LOW_S=
WATTNOT_STEPUP_RERUN_FACTOR=
WATTNOT_CHARS_PER_TOKEN=
WATTNOT_GPU_GB=
WATTNOT_DISK_FREE_FLOOR_GB=
HF_HOME=
HF_HUB_CACHE=
VLLM_CACHE_ROOT=
