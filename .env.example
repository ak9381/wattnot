# WattNot judge settings. Copy to .env in the repo root (gitignored) and fill in what you have.
# Every line is optional: with nothing set, ./run-local.sh runs the SIMULATED path.
# Never commit .env. WattNot never prints these values.

# Your own Meta model API key. Needed for the live token savers (routing, thinking budget, agentwaste).
META_API_KEY=your-meta-api-key-here
# Meta API base URL. Leave empty for the default.
META_BASE_URL=

# Your vLLM chat endpoint, on the GPU box where you run WattNot. Needed for the power-cap path.
WATTNOT_VLLM_URL=http://127.0.0.1:8000/v1/chat/completions
# Model settings for that server: muse-glimmer-30b or muse-glimmer-30b-fp8 (Meta models only).
WATTNOT_MODEL_CONFIG=muse-glimmer-30b
# Power cap (watts) to test against the stock limit.
WATTNOT_CAP_W=375
# Prompts per tier, 4 tiers. 0 runs all.
WATTNOT_PER_TIER=5
# 1 = put the GPU back to its stock power limit on exit, Ctrl-C or error. Keep it at 1.
WATTNOT_RESTORE_CAP=1
# 1 = also try power caps on a GPU we have not tested. Leave 0 unless you know your GPU.
WATTNOT_ALLOW_UNTESTED_GPU=0

# Spend ceiling in USD for the live Meta API steps, checked before each call.
WATTNOT_MAX_SPEND=0.50
# Dashboard port. A free one is picked if this is busy.
WATTNOT_PORT=8765

# Optional, only for the hosted-GPU paths we also tested. Not needed for judging.
BASETEN_METRICS_KEY=
MODAL_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Everything below is for maintainers and our own GPU rentals. Judges can ignore it.

## Secrets (keep out of git)
BASETEN_API_KEY=              # legacy hackathon key; dead (401), refused by the code; leave empty
HF_TOKEN=                     # Hugging Face, for gated open-weights downloads on a GPU host
E2E_API_KEY=                  # E2E Networks VM API (scripts/e2e/ctl.py via post.py)
E2E_API_TOKEN=                # E2E Networks VM API token
MODAL_TOKEN_ID=               # read by the modal CLI itself (usually ~/.modal.toml instead)
MODAL_TOKEN_SECRET=
MODAL_PROXY_TOKEN_ID=         # Modal web-endpoint proxy auth
MODAL_PROXY_TOKEN_SECRET=
WATTNOT_API_TOKEN=            # optional bearer token for the WattNot API
WATTNOT_DASH_TOKEN=           # optional bearer token for a hosted dashboard
WATCHDOG_PUBLISH_TOKEN=       # optional, watchdog heartbeat publishing

## Keys on disk (paths, not secrets themselves)
WATTNOT_CERT_KEY=             # certificate signing key path (default ~/.wattnot/cert-signing-key.pem)
WATTNOT_SIGN_KEY=             # receipt signing key path override
WATTNOT_REQUIRE_CERT_KEY=     # 1 = fail instead of falling back when the cert key is missing
WATTNOT_MUSE_AUTH=            # Muse login file path (default ~/.config/muse/auth.json)

## Endpoints and models
WATTNOT_META_BASE=
WATTNOT_MODAL_URL=
WATTNOT_BASE_URL=             # OpenAI-compatible server WattNot tunes (e.g. local vLLM)
JUDGE_BASE_URL=
JUDGE_MODEL=
WATTNOT_PLANNER_MODEL=
WATTNOT_SPARK_MODEL=
WATTNOT_SERVE_MODEL=
WATTNOT_SERVE_TP=
WATTNOT_SERVE_TOPK=

## Safety switches and spend caps (env can only tighten the built-in caps)
WATTNOT_META_MOCK=            # 1 = mock every Meta call, labelled MOCK
WATTNOT_LIVE=
WATTNOT_MODE=                 # watch | act
WATTNOT_MODAL_GO=             # 1 = allow a paid Modal launch (needs the owner's okay)
WATTNOT_MODAL_SMOKE=
RUN3_GO=                      # 1 = allow an E2E VM launch (needs the owner's okay)
RUN3_MAX_H=
RUN3_BUDGET_CAP_INR=
RUN3_DISK_GB=
BUDGET_CAP_INR=
MAX_HOURS=
WATTNOT_META_CAP_USD=
WATTNOT_META_SOFT_USD=
WATTNOT_BASETEN_CAP_USD=
WATTNOT_MAX_P99_INCREASE=
WATTNOT_APPROVAL_POLICY=
WATTNOT_APPROVER=
WATTNOT_ALLOW_NVML=

## Paths and tuning (optional)
WATTNOT_CONFIG=
WATTNOT_DATA_DIR=
WATTNOT_ROOT=
WATTNOT_SPEND_DIR=
WATTNOT_META_LEDGER=
WATTNOT_BASETEN_H2H_LEDGER=
WATTNOT_PROPOSALS_DIR=
WATTNOT_PREFIX_CACHE=         # on | off | auto
WATTNOT_PREFIX_CACHE_THRESHOLD=
WATTNOT_REASONING_MAX_TOKENS=
WATTNOT_REASONING_CAPS=
WATTNOT_STEPUP_MAX_LOW_S=
WATTNOT_STEPUP_RERUN_FACTOR=
WATTNOT_CHARS_PER_TOKEN=
WATTNOT_GPU_GB=
WATTNOT_DISK_FREE_FLOOR_GB=
HF_HOME=
HF_HUB_CACHE=
VLLM_CACHE_ROOT=
