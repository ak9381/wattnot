# Caps for the max plan (driver --plan max). Source this before ctl.py and the off-box watchdog:
#   set -a; . scripts/e2e/max-run.env; set +a
# Values must match driver.MAX_BOOKING_H / MAX_BUDGET_CAP_INR (tests/test_max_plan.py checks).
# ESTIMATE: 16 h x Rs 451.2 = Rs 7,219; the Rs 7,300 cap keeps the Rs 1,500 balance floor
# on the Rs 8,801.29 balance read on 1 Nov. ctl.py deletes the VM at RUN3_MAX_H - 8 min;
# the off-box watchdog is the backstop 6 min after the booking.
RUN3_MAX_H=16
RUN3_BUDGET_CAP_INR=7300
RUN3_OFFBOX_MAX_H=16.1
# the Mac watchdog (scripts/mac_watchdog/run-tmux.sh) reads these two
BUDGET_CAP_INR=7300
MAX_HOURS=16.1
# GitHub off-box watchdog: set repo variables WATCHDOG_BUDGET_CAP_INR=7300 and
# WATCHDOG_MAX_HOURS=16.1 by hand before launch (not done from here).
