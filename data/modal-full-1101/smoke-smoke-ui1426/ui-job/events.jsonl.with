{"type": "stage.features", "ts": "2026-11-01T14:27:12.478580+00:00", "run": "modal smoke-smoke-ui1426", "step_id": "m1", "data": {"stage": "modal", "features": [{"id": "effort_routing", "name": "Reasoning-effort + cheapest-first routing (low, step up on a failed check)", "status": "ON", "reason": "hosted API (per-token, no GPU access)"}, {"id": "thinking_budget", "name": "Thinking-budget enforcer (max_tokens per effort)", "status": "ON", "reason": "hosted API (per-token, no GPU access)"}, {"id": "router", "name": "Backend/effort router", "status": "ON", "reason": "thinking off first, per-tier thinking budget on a failed check; one backend"}, {"id": "context_saver", "name": "Agent saver: tool-output dedup + memory compression", "status": "ON", "reason": "hosted API (per-token, no GPU access)"}, {"id": "waste_guard", "name": "Agent-waste proxy (repeat/no-op/cycle/overspend detectors)", "status": "ON", "reason": "hosted API (per-token, no GPU access)"}, {"id": "code_mode", "name": "Code Mode with locked sandbox + network boundary", "status": "ON", "reason": "runs on the box over recorded traces"}, {"id": "prefix_cache_provider", "name": "Prefix caching (provider side, reported cached tokens)", "status": "ON", "reason": "our own vLLM; cached_tokens MEASURED from usage"}, {"id": "concurrency_batching", "name": "Concurrency batching (client side)", "status": "ON", "reason": "server-side batching via the kept --max-num-seqs"}, {"id": "gates", "name": "Noise gate, fixed answer gate, LLM judge, reasoning-leak strip", "status": "ON", "reason": "hosted API (per-token, no GPU access)"}, {"id": "spark_grades", "name": "Muse Spark grades every answer", "status": "ON", "reason": "Meta API"}, {"id": "joule_slo", "name": "Joule-SLO + user p99 limit", "status": "ON", "reason": "Joule-SLO + p99 limit on MEASURED energy"}, {"id": "eye_check", "name": "Eye check: vision gate on the SYNTHETIC Muse Image set", "status": "ON", "reason": "Meta API"}, {"id": "sam_hotspot", "name": "SAM 3.1 hotspot audit", "status": "ON", "reason": "Meta API"}, {"id": "hearing_check", "name": "Hearing check: Muse Voice Transcribe on spoken answers", "status": "ON", "reason": "Meta API"}, {"id": "wonder_planner", "name": "Muse Wonder planner + Wonderchart", "status": "ON", "reason": "Meta API"}, {"id": "spark_trace", "name": "Spark 4-call trace (probe, proposal, gate, receipt)", "status": "ON", "reason": "Meta API"}, {"id": "approvals", "name": "Approve-before-apply with risk classifier, undo", "status": "ON", "reason": "local"}, {"id": "musecode_pr", "name": "Muse Code PR flow (ak9381/wattnot-demo-deploy only)", "status": "ON", "reason": "patch always built; PR opened only with --open-pr at stage time"}, {"id": "receipt", "name": "Signed receipt + SCI carbon/water + joules per good answer", "status": "ON", "reason": "local signing key"}, {"id": "eu_report", "name": "EU report", "status": "ON", "reason": "local"}, {"id": "label_lint", "name": "Label-honesty lint", "status": "ON", "reason": "local"}, {"id": "spend_guard", "name": "Spend guards (Baseten hard cap, Meta soft cap, ledger)", "status": "ON", "reason": "Modal $40 stage cap + container timeout, Meta soft cap, ledger"}, {"id": "power_caps", "name": "Power-cap sweep + J/correct gate", "status": "OFF", "reason": "Modal refuses NVML power-limit writes (probed each round, recorded)"}, {"id": "fp8", "name": "FP8 quantization keep/reject gate", "status": "ON", "reason": "restart vLLM with --quantization fp8; kept only if accuracy holds (-2 pts) and J/correct drops, with the eye and hearing checks re-run on the candidate"}, {"id": "kv_batch", "name": "Batch-size + KV-cache sweep", "status": "ON", "reason": "sweep client concurrency x --max-num-seqs on a 24-item slice, keep the lowest MEASURED J/correct inside the quality gate"}, {"id": "vllm_prefix", "name": "vLLM prefix-cache control", "status": "ON", "reason": "--enable-prefix-caching in the with-WattNot server, off in the stock server"}, {"id": "clock_sidecar", "name": "Phase-aware clock sidecar, marginal-joule knee", "status": "OFF", "reason": "needs GPU clock writes, which Modal also refuses"}, {"id": "moe", "name": "MoE top-k / per-expert pinning", "status": "OFF", "reason": "Glimmer 30B is served here; MoE top-k needs Spark Open self-served (8x B200)"}, {"id": "measured_energy", "name": "MEASURED GPU energy (NVML)", "status": "ON", "reason": "NVML total-energy counter brackets each arm and each chunk of items"}, {"id": "flex", "name": "Flex grid-event load shedding", "status": "OFF", "reason": "simulator only"}, {"id": "rekor", "name": "Rekor publish", "status": "OFF", "reason": "only after the long run, with Akash's yes"}, {"id": "own_gpu_serving", "name": "Own-GPU vLLM serving + E2E rig", "status": "ON", "reason": "Glimmer 30B on our own vLLM, one A100 on Modal"}], "off_nodes": {"adaptive": "MoE top-k needs Spark Open self-served (8x B200)", "flex": "grid flex is simulator only", "spark_open": "816B side stage not run (about 700 GB GPU memory)", "baseten_model": "not used on this stage (our own vLLM on Modal)", "meters_roadmap": "Zeus/DCGM meters not bound; NVML is the meter", "certificate": "mock certificate format, not minted", "e2e_rig": "the H100 rig is not used; this stage runs on a Modal A100-80GB"}, "label": "MEASURED"}}
