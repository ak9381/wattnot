{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wattnot.receipt/1",
  "type": "object",
  "required": [
    "spec",
    "receipt_id",
    "created_at",
    "run_id",
    "subject",
    "baseline",
    "candidate",
    "result",
    "measurement",
    "planner_trace",
    "grade",
    "integrity"
  ],
  "properties": {
    "spec": {
      "const": "wattnot.receipt/1"
    },
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "model",
        "host",
        "mode",
        "workload"
      ]
    },
    "baseline": {
      "type": "object",
      "required": [
        "params",
        "reps",
        "wh_per_req",
        "p99_ms",
        "quality"
      ],
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "max_num_seqs": {},
            "enable_chunked_prefill": {},
            "enable_prefix_caching": {},
            "block_size": {},
            "quantization": {},
            "gpu_mem_util": {},
            "power_cap_w": {},
            "sm_clock_mhz": {}
          }
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "wh_per_req": {
          "type": "object",
          "required": [
            "mean",
            "sd"
          ],
          "properties": {
            "mean": {
              "type": "number"
            },
            "sd": {
              "type": "number"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "usd_per_req": {
          "type": "object",
          "required": [
            "mean",
            "sd"
          ],
          "properties": {
            "mean": {
              "type": "number"
            },
            "sd": {
              "type": "number"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "p99_ms": {
          "type": "number"
        },
        "quality": {
          "type": "object",
          "properties": {
            "fixed_pass_rate": {
              "type": "number"
            },
            "judge_score": {
              "type": "number"
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "params",
        "reps",
        "wh_per_req",
        "p99_ms",
        "quality"
      ],
      "properties": {
        "params": {
          "type": "object",
          "properties": {
            "max_num_seqs": {},
            "enable_chunked_prefill": {},
            "enable_prefix_caching": {},
            "block_size": {},
            "quantization": {},
            "gpu_mem_util": {},
            "power_cap_w": {},
            "sm_clock_mhz": {}
          }
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "wh_per_req": {
          "type": "object",
          "required": [
            "mean",
            "sd"
          ],
          "properties": {
            "mean": {
              "type": "number"
            },
            "sd": {
              "type": "number"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "usd_per_req": {
          "type": "object",
          "required": [
            "mean",
            "sd"
          ],
          "properties": {
            "mean": {
              "type": "number"
            },
            "sd": {
              "type": "number"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "p99_ms": {
          "type": "number"
        },
        "quality": {
          "type": "object",
          "properties": {
            "fixed_pass_rate": {
              "type": "number"
            },
            "judge_score": {
              "type": "number"
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "saving_pct",
        "welch",
        "billable",
        "billed_saving_pct"
      ]
    },
    "measurement": {
      "type": "object",
      "required": [
        "meter",
        "hz",
        "csv",
        "label"
      ],
      "properties": {
        "label": {
          "enum": [
            "MEASURED",
            "ESTIMATE",
            "SIMULATED"
          ]
        },
        "spark_trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "judge_verdict": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pass",
            "fail",
            null
          ]
        },
        "judge_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "judge_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "wonder_trace_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "per_model_spend": {
          "type": [
            "object",
            "null"
          ]
        },
        "musecode_patch_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "musecode_pr_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "musecode_pr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "hotspot_cap": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "mask": {
              "type": "object",
              "properties": {
                "bbox": {
                  "type": "array"
                },
                "polygon": {
                  "type": "array"
                },
                "rle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sha256": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "decision": {
              "type": "object",
              "properties": {
                "gpu_id": {
                  "type": [
                    "integer",
                    "string",
                    "null"
                  ]
                },
                "old_cap_w": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "new_cap_w": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "delta_w": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "min_cap_w": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "eye_test": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "passed": {
              "type": "boolean"
            },
            "checked": {
              "type": "integer"
            },
            "passed_count": {
              "type": "integer"
            },
            "missed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "est_wh_per_image": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "images": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "string"
                  },
                  "got": {
                    "type": "string"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "hotspot_test": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "label": { "type": "string" },
            "detector": { "type": "string" },
            "passed": { "type": "boolean" },
            "checked": { "type": "integer" },
            "passed_count": { "type": "integer" },
            "missed": { "type": "array", "items": { "type": "string" } },
            "faults": { "type": "array", "items": { "type": "string" } },
            "iou_pass": { "type": "number" },
            "reason": { "type": "string" },
            "est_wh_per_image": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "label": { "type": "string" }
              }
            },
            "scenes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "fault": { "type": "string" },
                  "slot": { "type": "integer" },
                  "expected_bbox": { "type": "array", "items": { "type": "number" } },
                  "got_bbox": { "type": "array", "items": { "type": "number" } },
                  "iou": { "type": "number" },
                  "ok": { "type": "boolean" },
                  "mask_label": { "type": "string" },
                  "label": { "type": "string" }
                }
              }
            }
          }
        },
        "wonder_chart": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "label": { "type": "string" },
            "chart_sha256": { "type": "string" },
            "source": { "type": "string" },
            "offline_fallback": { "type": "boolean" },
            "model": { "type": "string" },
            "suggestion": {
              "type": "object",
              "properties": {
                "action": { "type": "string" },
                "cap_w": { "type": ["integer", "null"] },
                "clock_profile": { "type": ["string", "null"] }
              }
            },
            "reason": { "type": "string" },
            "trace_id": { "type": "string" },
            "est_wh": {
              "type": "object",
              "properties": {
                "value": { "type": "number" },
                "label": { "type": "string" }
              }
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "setting": { "type": "string" },
                  "cap_w": { "type": "integer" },
                  "clock_profile": { "type": "string" },
                  "joules_per_correct": { "type": "number" },
                  "quality": { "type": "number" },
                  "kept": { "type": "boolean" },
                  "label": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "hotspot_cap": {
      "type": [
        "object",
        "null"
      ]
    },
    "attribution": {
      "type": "object"
    },
    "planner_trace": {
      "type": "array"
    },
    "estimates": {
      "type": "object",
      "properties": {
        "water_ml_per_req": {
          "type": "object",
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "label": {
              "const": "ESTIMATE"
            },
            "method": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "description": "Candidate water per request, mL. Always ESTIMATE."
        },
        "baseline_water_ml_per_req": {
          "type": "object",
          "required": [
            "value",
            "label"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "label": {
              "const": "ESTIMATE"
            },
            "method": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "description": "Optional. Baseline water per request, mL, same method as candidate. Always ESTIMATE. If absent, UI derives it as ESTIMATE."
        },
        "sci_gco2e_per_req": {
          "type": "object"
        }
      }
    },
    "grade": {
      "enum": [
        "VALID",
        "ESTIMATE",
        "SIMULATED",
        "UNVERIFIABLE",
        "NOISE"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "canonicalization",
        "sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "JCS RFC 8785"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prev_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "signer": {
          "type": [
            "string",
            "null"
          ]
        },
        "rekor": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "compare_to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^run_[0-9]{8}_[0-9]{6}_[0-9a-f]{6}$",
      "description": "Optional. run_id of the baseline run, so the UI can load the real before canvas. If absent, UI rebuilds the before canvas from the receipt baseline."
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "prompts"
        ]
      },
      {
        "required": [
          "outputs"
        ]
      },
      {
        "required": [
          "prompt"
        ]
      }
    ]
  }
}