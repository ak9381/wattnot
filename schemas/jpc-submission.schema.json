{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wattnot.jpc-submission/0.1",
  "title": "WattNot joules-per-correct-answer leaderboard submission",
  "description": "One setup's net joules per correct answer, with the signed receipt that backs it. See docs/joules-per-correct-answer.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "setup", "model", "hardware", "j_per_correct", "pass_pct", "label", "receipt"],
  "properties": {
    "spec": {"const": "wattnot.jpc-submission/0.1"},
    "setup": {"type": "string", "minLength": 1, "maxLength": 200},
    "model": {"type": "string", "minLength": 1, "maxLength": 200},
    "hardware": {"type": "string", "minLength": 1, "maxLength": 200},
    "workload": {"type": "string", "maxLength": 200},
    "n_checked": {"type": ["integer", "null"], "minimum": 1},
    "repeats": {"type": ["integer", "null"], "minimum": 1},
    "sample_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "j_per_correct": {
      "type": "object",
      "required": ["mean"],
      "additionalProperties": false,
      "properties": {
        "mean": {"type": "number", "exclusiveMinimum": 0},
        "sd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "overhead_j_per_correct": {"type": ["number", "null"], "minimum": 0},
    "pass_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "p99_change_pct": {"type": ["number", "null"]},
    "escalation_rate_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "small_model_pass_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "label": {"enum": ["MEASURED", "ESTIMATE"]},
    "receipt": {"type": "string", "minLength": 1, "maxLength": 500}
  },
  "not": {"anyOf": [{"required": ["prompts"]}, {"required": ["outputs"]}, {"required": ["prompt"]}]}
}
